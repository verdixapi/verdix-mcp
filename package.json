{
  "name": "verdix-mcp",
  "version": "0.1.1",
  "mcpName": "com.verdixapi/verdix",
  "description": "MCP server for Verdix: check an EVM address on Base before sending it funds (safe/caution/danger). Pays per call via x402 from your own wallet, with a max-price cap.",
  "type": "module",
  "bin": {
    "verdix-mcp": "src/index.js"
  },
  "main": "src/verdix.js",
  "files": [
    "src/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/index.js",
    "test": "node test/offline.test.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "x402",
    "base",
    "usdc",
    "wallet",
    "address",
    "risk",
    "scam",
    "security",
    "agents"
  ],
  "homepage": "https://api.verdixapi.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/verdixapi/verdix-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/verdixapi/verdix-mcp/issues"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "@x402/core": "2.27.0",
    "@x402/evm": "2.27.0",
    "@x402/fetch": "2.27.0",
    "viem": "2.56.9",
    "zod": "^3.25.0"
  }
}
